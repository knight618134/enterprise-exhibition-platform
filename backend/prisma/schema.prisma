generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExhibitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Exhibition {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(2000)
  startAt     DateTime
  endAt       DateTime
  status      ExhibitionStatus  @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  venues      ExhibitionVenue[]

  @@index([status])
  @@index([startAt, endAt])
}

model Venue {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  location    String?           @db.VarChar(200)
  capacity    Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exhibitions ExhibitionVenue[]

  @@index([name])
}

model ExhibitionVenue {
  exhibitionId String     @db.Uuid
  venueId      String     @db.Uuid
  assignedAt   DateTime   @default(now())
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([exhibitionId, venueId])
  @@index([venueId])
}
